    {
      "name": "Application card",
      "kind": "card",
      "refersTo": "card",
      "description": "Reduced application-card preview with synthetic sample content: desktop padding, shared role/company identity without an initial avatar, stage, separate next-action row and details link. Optional metadata and icons omitted here.",
      "html": "<a class=\"ds-application\" href=\"#application\"><div class=\"ds-application-identity\"><h2>Frontend developer</h2><p>Example company</p></div><span class=\"ds-application-stage\"><span aria-hidden=\"true\"></span>Applied</span><div class=\"ds-application-next\"><div><strong>Next action</strong><span class=\"ds-application-action\">Waiting for response</span></div><p>Waiting for the company to respond.</p></div><div class=\"ds-application-footer\"><span>Applied date not recorded</span><strong>Open details</strong></div></a>",
      "css": ".ds-application{display:flex;flex-direction:column;gap:14px;padding:20px;border:1px solid #D7DFE5;border-radius:8px;background:#FFFFFF;color:#222B34;text-decoration:none;box-shadow:none;font-family:Inter,Segoe UI,Helvetica Neue,sans-serif;font-size:1rem;line-height:1.5;transition:border-color 160ms ease}.ds-application:hover{border-color:#235FC7;background:#F5F5F5}.ds-application:focus-visible{outline:2px solid #235FC7;outline-offset:3px}.ds-application-identity{display:flex;flex-direction:column;gap:4px;min-width:0}.ds-application-identity p{font-weight:500}.ds-application h2{margin:0;font-size:1.125rem;font-weight:700;line-height:1.35;letter-spacing:-.01em;overflow-wrap:anywhere;text-wrap:balance}.ds-application p{margin:0;color:#586672;overflow-wrap:anywhere}.ds-application-stage{display:inline-flex;align-items:center;align-self:flex-start;gap:6px;height:24px;padding:0 8px;font-size:.8125rem;font-weight:600;color:#586672;border:1px solid rgba(88,102,114,.28);background:rgba(88,102,114,.1);border-radius:4px}.ds-application-stage>span{width:7px;height:7px;border-radius:50%;background:currentColor;border:1px solid currentColor}.ds-application-next{border-top:1px solid #D7DFE5;padding-top:12px;font-size:.875rem}.ds-application-next>div{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}.ds-application-action{color:#586672;border:1px solid rgba(88,102,114,.24);background:rgba(88,102,114,.08);border-radius:4px;padding:2px 7px;font-size:.8125rem;font-weight:600}.ds-application-next p{margin-top:8px}.ds-application-footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid #D7DFE5;padding-top:14px;font-size:.875rem;color:#586672}.ds-application-footer strong{color:#235FC7;font-weight:600}"
    }
  ],
  "narrative": {
    "northStar": "Search agenda",
    "overview": "A personal job search needs clear records, explicit waiting and useful next steps.\nThe interface is calm, focused and slightly technical: readable Inter text, neutral\nsurfaces, aligned dates and one blue accent. Its personality comes from the\nrelationship between an application, its saved stage and its next action.\n\nThis is the implemented identity selected on 2026-10-05. Generated concepts guide\nits character; actual components establish its reusable rules. Page compositions\nbelong in [.impeccable/surfaces/web-app.md](.impeccable/surfaces/web-app.md).",
    "keyCharacteristics": [
      "Open sections and modest borders instead of repeated summary cards.",
      "Neutral saved stages and waiting; blue for action, selection and focus.",
      "The dot–rule–outlined-dot signature accompanies Next Action.",
      "One identity across light and dark mode."
    ],
    "rules": [
      {
        "name": "The Action Rule",
        "body": "A derived suggestion does not become a red deadline simply because it needs attention. Preserve its words and distinguish it from a saved date.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve stage words, action words and recorded dates as separate cues.",
      "Do use the shared theme and components for both modes.",
      "Do retain visible focus, text labels, semantic headings and wrapping content.",
      "Do group real records and tasks while leaving summaries open."
    ],
    "donts": [
      "Don't add gradients, decorative AI imagery, excessive cards or generic KPI tiles.",
      "Don't turn waiting or missing optional information into a visual failure.",
      "Don't interpret the signature as a funnel or invent interaction for it.",
      "Don't copy synthetic counts, controls or screen geometry from concept images."
    ]
  }
}
